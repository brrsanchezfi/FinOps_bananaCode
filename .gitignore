# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Databricks Asset Bundles
.databricks/
*.lock.json

# NOTA: dashboards/<env>/*.lvdash.json SI se versionan aunque sean generados.
# El CLI de Databricks excluye del arbol del bundle todo lo que git ignora, asi
# que un dashboard en una ruta ignorada da "no such file or directory" al
# desplegar. Se regeneran con `python scripts/dashboards.py generate` y CI
# verifica que no haya deriva.

# Secretos / credenciales (nunca commitear)
.env
*.pem
*.key
conf/*.secret.yml

# Configuracion del DESPLIEGUE CONCRETO: workspaces, unidades de negocio,
# presupuestos y responsables del cliente. El repositorio distribuye producto,
# no instalaciones. Las plantillas `conf/*.example.yml` SI se versionan.
#
# OJO: el CLI de Databricks excluye del bundle lo que git ignora, asi que estos
# archivos se fuerzan de vuelta con `sync.include` en databricks.yml. Si se
# quitan de ahi, el pipeline corre en el workspace con la configuracion neutra
# del repositorio y las cifras salen sin atribuir.
conf/local.yml
conf/*.local.yml
!conf/*.example.yml

# Sistema operativo / editores
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json

# Salidas locales
out/
tmp/
*.log
