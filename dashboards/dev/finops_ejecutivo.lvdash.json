{
  "datasets": [
    {
      "name": "kpi_actual",
      "displayName": "KPIs del ultimo dia cerrado",
      "queryLines": [
        "SELECT\n",
        "  total_cost_usd,\n",
        "  mtd_cost_usd,\n",
        "  rolling_7d_avg_usd,\n",
        "  COALESCE(dod_change_pct, 0) * 100 AS dod_change_pct,\n",
        "  COALESCE(wow_change_pct, 0) * 100 AS wow_change_pct,\n",
        "  COALESCE(allocation_coverage_ratio, 0) * 100 AS allocation_coverage_pct,\n",
        "  active_entities,\n",
        "  usage_date\n",
        "FROM finops_dev.gold.fct_kpi_daily\n",
        "QUALIFY ROW_NUMBER() OVER (ORDER BY usage_date DESC) = 1\n"
      ]
    },
    {
      "name": "serie_costo",
      "displayName": "Costo diario y media movil",
      "queryLines": [
        "SELECT\n",
        "  usage_date,\n",
        "  total_cost_usd,\n",
        "  rolling_7d_avg_usd,\n",
        "  rolling_28d_avg_usd\n",
        "FROM finops_dev.gold.fct_kpi_daily\n",
        "WHERE usage_date >= CURRENT_DATE() - INTERVAL 90 DAYS\n",
        "ORDER BY usage_date\n"
      ]
    },
    {
      "name": "costo_por_equipo",
      "displayName": "Costo por equipo (30 dias)",
      "queryLines": [
        "SELECT\n",
        "  team,\n",
        "  SUM(total_cost_usd) AS total_cost_usd\n",
        "FROM finops_dev.gold.fct_cost_daily\n",
        "WHERE usage_date >= CURRENT_DATE() - INTERVAL 30 DAYS\n",
        "GROUP BY team\n",
        "ORDER BY total_cost_usd DESC\n",
        "LIMIT 15\n"
      ]
    },
    {
      "name": "costo_por_sku",
      "displayName": "Mezcla de consumo por tipo de compute (30 dias)",
      "queryLines": [
        "SELECT\n",
        "  sku_group,\n",
        "  SUM(total_cost_usd) AS total_cost_usd\n",
        "FROM finops_dev.gold.fct_cost_daily\n",
        "WHERE usage_date >= CURRENT_DATE() - INTERVAL 30 DAYS\n",
        "GROUP BY sku_group\n",
        "ORDER BY total_cost_usd DESC\n"
      ]
    },
    {
      "name": "presupuestos",
      "displayName": "Estado de presupuestos vigentes",
      "queryLines": [
        "SELECT\n",
        "  budget_name,\n",
        "  scope_label,\n",
        "  budget_amount_usd,\n",
        "  actual_cost_usd,\n",
        "  consumed_pct,\n",
        "  projected_total_usd,\n",
        "  projected_pct,\n",
        "  status,\n",
        "  remaining_days,\n",
        "  required_daily_cost_usd\n",
        "FROM finops_dev.gold.fct_budget_status\n",
        "QUALIFY ROW_NUMBER() OVER (PARTITION BY budget_id ORDER BY as_of_date DESC) = 1\n",
        "ORDER BY consumed_pct DESC\n"
      ]
    },
    {
      "name": "pronostico_org",
      "displayName": "Ejecutado vs pronosticado",
      "queryLines": [
        "SELECT\n",
        "  usage_date AS fecha,\n",
        "  total_cost_usd AS costo_usd,\n",
        "  'Ejecutado' AS serie\n",
        "FROM finops_dev.gold.fct_kpi_daily\n",
        "WHERE usage_date >= CURRENT_DATE() - INTERVAL 60 DAYS\n",
        "\n",
        "UNION ALL\n",
        "\n",
        "SELECT\n",
        "  forecast_date AS fecha,\n",
        "  predicted_cost_usd AS costo_usd,\n",
        "  'Pronosticado' AS serie\n",
        "FROM finops_dev.gold.fct_cost_forecast\n",
        "WHERE dimension = 'organizacion'\n"
      ]
    },
    {
      "name": "anomalias",
      "displayName": "Anomalias recientes",
      "queryLines": [
        "SELECT\n",
        "  usage_date,\n",
        "  dimension,\n",
        "  dimension_value,\n",
        "  severity,\n",
        "  direction,\n",
        "  actual_cost_usd,\n",
        "  expected_cost_usd,\n",
        "  deviation_usd,\n",
        "  ROUND(pct_change * 100, 1) AS pct_change,\n",
        "  score\n",
        "FROM finops_dev.gold.fct_cost_anomaly\n",
        "WHERE usage_date >= CURRENT_DATE() - INTERVAL 14 DAYS\n",
        "  AND severity IN ('high', 'critical')\n",
        "ORDER BY usage_date DESC, ABS(score) DESC\n",
        "LIMIT 50\n"
      ]
    },
    {
      "name": "top_entidades",
      "displayName": "Recursos de mayor costo (30 dias)",
      "queryLines": [
        "SELECT\n",
        "  entity_name,\n",
        "  entity_type,\n",
        "  team,\n",
        "  cost_center,\n",
        "  environment,\n",
        "  SUM(total_cost_usd) AS total_cost_usd\n",
        "FROM finops_dev.gold.fct_cost_daily\n",
        "WHERE usage_date >= CURRENT_DATE() - INTERVAL 30 DAYS\n",
        "GROUP BY entity_name, entity_type, team, cost_center, environment\n",
        "ORDER BY total_cost_usd DESC\n",
        "LIMIT 25\n"
      ]
    }
  ],
