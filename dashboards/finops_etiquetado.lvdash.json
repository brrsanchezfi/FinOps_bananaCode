{
  "datasets": [
    {
      "name": "cobertura_hoy",
      "displayName": "Cobertura de etiquetado por dimension (ultimos 30 dias)",
      "queryLines": [
        "SELECT\n",
        "  dimension,\n",
        "  ROUND(SUM(attributed_cost_usd), 2) AS costo_atribuido_usd,\n",
        "  ROUND(SUM(unattributed_cost_usd), 2) AS costo_sin_atribuir_usd,\n",
        "  ROUND(100.0 * SUM(attributed_cost_usd) / NULLIF(SUM(total_cost_usd), 0), 1) AS cobertura_pct\n",
        "FROM finops.gold.vw_tag_coverage_live\n",
        "WHERE usage_date >= CURRENT_DATE() - INTERVAL 30 DAYS\n",
        "GROUP BY dimension\n",
        "ORDER BY cobertura_pct\n"
      ]
    },
    {
      "name": "cobertura_serie",
      "displayName": "Evolucion de la cobertura por dimension",
      "queryLines": [
        "SELECT\n",
        "  usage_date,\n",
        "  dimension,\n",
        "  ROUND(100.0 * SUM(attributed_cost_usd) / NULLIF(SUM(total_cost_usd), 0), 2) AS cobertura_pct\n",
        "FROM finops.gold.vw_tag_coverage_live\n",
        "WHERE usage_date >= CURRENT_DATE() - INTERVAL 60 DAYS\n",
        "GROUP BY usage_date, dimension\n",
        "ORDER BY usage_date\n"
      ]
    },
    {
      "name": "resumen_global",
      "displayName": "Gasto total y gasto sin etiquetar",
      "queryLines": [
        "SELECT\n",
        "  ROUND(SUM(list_cost_usd), 2) AS costo_total_usd,\n",
        "  ROUND(SUM(CASE WHEN SIZE(COALESCE(custom_tags, MAP())) = 0\n",
        "                 THEN list_cost_usd ELSE 0 END), 2) AS costo_sin_etiquetas_usd,\n",
        "  COUNT(DISTINCT entity_id) AS recursos\n",
        "FROM finops.gold.vw_usage_live\n",
        "WHERE usage_date >= CURRENT_DATE() - INTERVAL 30 DAYS\n"
      ]
    },
    {
      "name": "claves_no_reconocidas",
      "displayName": "Claves en uso que la configuracion no reconoce",
      "queryLines": [
        "SELECT\n",
        "  tag_key AS clave,\n",
        "  distinct_values AS valores_distintos,\n",
        "  records AS registros,\n",
        "  list_cost_usd AS costo_usd\n",
        "FROM finops.gold.vw_tag_inventory_live\n",
        "WHERE NOT is_recognized\n",
        "ORDER BY list_cost_usd DESC\n",
        "LIMIT 30\n"
      ]
    },
    {
      "name": "inventario",
      "displayName": "Inventario de claves de etiqueta en uso",
      "queryLines": [
        "SELECT\n",
        "  tag_key AS clave,\n",
        "  COALESCE(maps_to_dimension, 'NO RECONOCIDA') AS dimension,\n",
        "  distinct_values AS valores_distintos,\n",
        "  records AS registros,\n",
        "  list_cost_usd AS costo_usd\n",
        "FROM finops.gold.vw_tag_inventory_live\n",
        "ORDER BY list_cost_usd DESC\n",
        "LIMIT 50\n"
      ]
    },
    {
      "name": "sin_etiquetar",
      "displayName": "Recursos con costo y sin ninguna dimension resoluble",
      "queryLines": [
        "SELECT\n",
        "  entity_type,\n",
        "  entity_id,\n",
        "  sku_name,\n",
        "  billing_origin_product,\n",
        "  records,\n",
        "  first_seen,\n",
        "  last_seen,\n",
        "  list_cost_usd\n",
        "FROM finops.gold.vw_untagged_spend_live\n",
        "ORDER BY list_cost_usd DESC\n",
        "LIMIT 100\n"
      ]
    },
    {
      "name": "sin_etiquetar_por_tipo",
      "displayName": "Gasto sin atribuir por tipo de recurso",
      "queryLines": [
        "SELECT\n",
        "  entity_type,\n",
        "  ROUND(SUM(list_cost_usd), 2) AS costo_usd\n",
        "FROM finops.gold.vw_untagged_spend_live\n",
        "GROUP BY entity_type\n",
        "ORDER BY costo_usd DESC\n"
      ]
    }
  ],
