{
  "datasets": [
    {
      "name": "resumen_ahorro",
      "displayName": "Potencial de ahorro identificado",
      "queryLines": [
        "SELECT\n",
        "  SUM(estimated_monthly_savings_usd) AS ahorro_mensual_usd,\n",
        "  SUM(CASE WHEN confidence = 'alta' THEN estimated_monthly_savings_usd ELSE 0 END) AS ahorro_alta_confianza_usd,\n",
        "  COUNT(*) AS recomendaciones,\n",
        "  COUNT(DISTINCT entity_key) AS recursos_afectados\n",
        "FROM finops.gold.fct_recommendation\n",
        "WHERE analysis_date = (SELECT MAX(analysis_date) FROM finops.gold.fct_recommendation)\n"
      ]
    },
    {
      "name": "ahorro_por_regla",
      "displayName": "Ahorro estimado por tipo de hallazgo",
      "queryLines": [
        "SELECT\n",
        "  rule_id,\n",
        "  COUNT(*) AS hallazgos,\n",
        "  SUM(estimated_monthly_savings_usd) AS ahorro_mensual_usd\n",
        "FROM finops.gold.fct_recommendation\n",
        "WHERE analysis_date = (SELECT MAX(analysis_date) FROM finops.gold.fct_recommendation)\n",
        "GROUP BY rule_id\n",
        "ORDER BY ahorro_mensual_usd DESC\n"
      ]
    },
    {
      "name": "recomendaciones",
      "displayName": "Recomendaciones accionables",
      "queryLines": [
        "SELECT\n",
        "  rule_id,\n",
        "  title,\n",
        "  entity_name,\n",
        "  entity_type,\n",
        "  team,\n",
        "  cost_center,\n",
        "  environment,\n",
        "  observed_cost_usd,\n",
        "  estimated_monthly_savings_usd,\n",
        "  confidence,\n",
        "  severity,\n",
        "  recommendation,\n",
        "  estimation_method\n",
        "FROM finops.gold.fct_recommendation\n",
        "WHERE analysis_date = (SELECT MAX(analysis_date) FROM finops.gold.fct_recommendation)\n",
        "ORDER BY estimated_monthly_savings_usd DESC\n",
        "LIMIT 200\n"
      ]
    },
    {
      "name": "eficiencia",
      "displayName": "Indicadores de eficiencia",
      "queryLines": [
        "SELECT\n",
        "  usage_date,\n",
        "  ROUND(COALESCE(serverless_share, 0) * 100, 2) AS serverless_pct,\n",
        "  ROUND(COALESCE(all_purpose_share, 0) * 100, 2) AS all_purpose_pct,\n",
        "  ROUND(COALESCE(allocation_coverage_ratio, 0) * 100, 2) AS cobertura_pct,\n",
        "  cost_per_dbu_usd\n",
        "FROM finops.gold.fct_kpi_daily\n",
        "WHERE usage_date >= CURRENT_DATE() - INTERVAL 90 DAYS\n",
        "ORDER BY usage_date\n"
      ]
    },
    {
      "name": "gasto_sin_atribuir",
      "displayName": "Gasto sin atribucion por recurso (30 dias)",
      "queryLines": [
        "SELECT\n",
        "  entity_name,\n",
        "  entity_type,\n",
        "  workspace_id,\n",
        "  SUM(total_cost_usd) AS costo_usd\n",
        "FROM finops.gold.fct_cost_daily\n",
        "WHERE usage_date >= CURRENT_DATE() - INTERVAL 30 DAYS\n",
        "  AND is_untagged = true\n",
        "GROUP BY entity_name, entity_type, workspace_id\n",
        "ORDER BY costo_usd DESC\n",
        "LIMIT 50\n"
      ]
    },
    {
      "name": "jobs_inestables",
      "displayName": "Jobs con mayor desperdicio por fallos (30 dias)",
      "queryLines": [
        "SELECT\n",
        "  COALESCE(job_name, CAST(job_id AS STRING)) AS job,\n",
        "  team,\n",
        "  COUNT(*) AS ejecuciones,\n",
        "  SUM(CASE WHEN is_failed THEN 1 ELSE 0 END) AS fallidas,\n",
        "  ROUND(SUM(CASE WHEN is_failed THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0) * 100, 1) AS tasa_fallo_pct,\n",
        "  ROUND(SUM(CASE WHEN is_failed THEN run_cost_usd ELSE 0 END), 2) AS costo_fallido_usd\n",
        "FROM finops.gold.fct_job_run_cost\n",
        "WHERE run_date >= CURRENT_DATE() - INTERVAL 30 DAYS\n",
        "GROUP BY job, team\n",
        "HAVING SUM(CASE WHEN is_failed THEN 1 ELSE 0 END) > 0\n",
        "ORDER BY costo_fallido_usd DESC\n",
        "LIMIT 30\n"
      ]
    },
    {
      "name": "config_clusters",
      "displayName": "Configuracion de clusters con costo",
      "queryLines": [
        "SELECT\n",
        "  e.entity_name,\n",
        "  e.workspace_id,\n",
        "  e.autotermination_minutes,\n",
        "  e.autoscale_enabled,\n",
        "  e.num_workers,\n",
        "  e.spark_version,\n",
        "  e.days_since_activity,\n",
        "  e.lifetime_cost_usd\n",
        "FROM finops.gold.dim_entity e\n",
        "WHERE e.entity_type = 'CLUSTER'\n",
        "ORDER BY e.lifetime_cost_usd DESC\n",
        "LIMIT 100\n"
      ]
    },
    {
      "name": "salud_pipeline",
      "displayName": "Ultimas corridas del pipeline FinOps",
      "queryLines": [
        "SELECT\n",
        "  run_id,\n",
        "  run_date,\n",
        "  stage,\n",
        "  status,\n",
        "  duration_seconds,\n",
        "  rows_written,\n",
        "  error_message\n",
        "FROM finops.gold.ops_run_log\n",
        "WHERE run_started_at >= CURRENT_TIMESTAMP() - INTERVAL 7 DAYS\n",
        "ORDER BY run_started_at DESC, stage\n",
        "LIMIT 200\n"
      ]
    },
    {
      "name": "alertas",
      "displayName": "Alertas recientes",
      "queryLines": [
        "SELECT\n",
        "  created_at,\n",
        "  rule_id,\n",
        "  severity,\n",
        "  title,\n",
        "  scope,\n",
        "  dispatch_status,\n",
        "  channels,\n",
        "  delivered\n",
        "FROM finops.gold.ops_alert_log\n",
        "WHERE created_at >= CURRENT_TIMESTAMP() - INTERVAL 14 DAYS\n",
        "ORDER BY created_at DESC\n",
        "LIMIT 200\n"
      ]
    }
  ],
